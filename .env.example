GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# Local Silero speech detection; provider restores Gemini's built-in detector for comparison.
VOICE_INPUT_MODE=local
GEMINI_DECISION_MODEL=gemini-2.5-flash
