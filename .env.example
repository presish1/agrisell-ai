PORT=8787
HOST=127.0.0.1
APP_URL=http://localhost:8787
ADMIN_TOKEN=

# India Open Government Data / AGMARKNET
# Create a key at https://data.gov.in/
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_VARIETY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# Twilio Programmable Voice. Keep CALLS_ENABLED=false until consent and numbers are verified.
CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
